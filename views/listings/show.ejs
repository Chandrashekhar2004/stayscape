<% layout("layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-8 offset-3 listing-card">
            <h3>
                <%= listing.title %>
            </h3>
        </div>
        <div class="card col-6 offset-3 show-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image">
            <div class="card-body">
                <p class="card-title">
                 <i>Owned by <%= listing.owner.username %></i>  
                 <br> 
                    <%= listing.description %> <br>
                        &#8377; <%= listing.price.toLocaleString('en-IN') %> per night <br>
                            <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>
        <br><br>
        <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="btns mb-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 edit-btn">
                Edit
            </a>
            <Form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark offset-3 ">
                    Delete
                </button>
            </Form>
        </div>
        <% } %>
        <div class="col-8 offset-3 mb-5">
            <hr>
            <h4>Leave a Review</h4>
            <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating:</label>
                    <input type="range" id="rating" name="review[rating]" min="1" max="5" class="form-range">
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comment:</label>
                    <textarea id="comment" name="review[comment]" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Please enter a comment.
                    </div>
                </div>
                <button type="submit" class="btn btn-outline-dark mt-2">Submit</button>
            </form>

            <hr>
            <h4>Reviews:</h4>
            <div class="row">
                <p>
                    <%= listing.reviews.length %> reviews
                </p>
                <% for(let review of listing.reviews) { %>
                    <div class="card mb-3 col-5 ms-3">
                        <div class="card-body">
                            <h5 class="card-title">Rating: <%= review.rating %> / 5</h5>
                            <p class="card-text">
                                <%= review.comment %>
                            </p>
                        </div>
                        <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-dark offset-3 ">
                                Delete
                            </button>
                        </form>
                    </div>
                    <% } %>
            </div>
        </div>
    </div>